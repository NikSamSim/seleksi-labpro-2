# =========================================================
# Runtime
# =========================================================

NODE_ENV=development

# =========================================================
# Service Ports
# =========================================================

AUTH_SERVER_PORT=3000
CONTROL_PANEL_PORT=3001

APP_A_PORT=4000
APP_B_PORT=4001

SYNC_WORKER_PORT=5000
EVENT_PUBLISHER_PORT=5001
PROMETHEUS_PORT=9090

# =========================================================
# Primary Database
# =========================================================

PRIMARY_DB_USER=labpro
PRIMARY_DB_PASSWORD=change-me
PRIMARY_DB_NAME=auth_provider
PRIMARY_DB_PORT=5432

# Used when service is run directly from host machine
PRIMARY_DATABASE_URL=postgresql://labpro:change-me@localhost:5432/auth_provider

# =========================================================
# App A Database
# =========================================================

APP_A_DB_USER=labpro
APP_A_DB_PASSWORD=change-me
APP_A_DB_NAME=app_a
APP_A_DB_PORT=5433

# Used when service is run directly from host machine
APP_A_DATABASE_URL=postgresql://labpro:change-me@localhost:5433/app_a

# =========================================================
# App B Database
# =========================================================

APP_B_DB_USER=labpro
APP_B_DB_PASSWORD=change-me
APP_B_DB_NAME=app_b
APP_B_DB_PORT=5434

# Used when service is run directly from host machine
APP_B_DATABASE_URL=postgresql://labpro:change-me@localhost:5434/app_b

# =========================================================
# RabbitMQ
# =========================================================

RABBITMQ_USER=labpro
RABBITMQ_PASSWORD=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Used when service is run directly from host machine
RABBITMQ_URL=amqp://labpro:change-me@localhost:5672

# =========================================================
# Prometheus
# =========================================================

PROMETHEUS_URL=http://localhost:9090

# =========================================================
# Auth Provider
# =========================================================

CONTROL_PANEL_ORIGIN=http://localhost:3001

SSO_COOKIE_NAME=labpro_sso
SSO_SESSION_TTL_SECONDS=28800

AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=3600

APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=change-me-app-a-secret
APP_A_REDIRECT_URI=http://localhost:4000/callback
APP_A_LAUNCH_URL=http://localhost:4000
APP_A_LOGOUT_NOTIFICATION_URL=http://app-a:4000/internal/logout

APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=change-me-app-b-secret
APP_B_REDIRECT_URI=http://localhost:4001/callback
APP_B_LAUNCH_URL=http://localhost:4001
APP_B_LOGOUT_NOTIFICATION_URL=http://app-b:4001/internal/logout

SEED_USER_PASSWORD=change-me-user-password

# =========================================================
# Control Panel
# =========================================================

VITE_AUTH_SERVER_URL=http://localhost:3000

# =========================================================
# MFA / TOTP
# =========================================================

MFA_ISSUER=Labpro Auth Provider
MFA_PENDING_COOKIE_NAME=labpro_mfa_pending
MFA_CHALLENGE_TTL_SECONDS=300
MFA_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
MFA_RECENT_VERIFICATION_SECONDS=600
MFA_ENROLLMENT_TTL_SECONDS=600

# =========================================================
# Relying Applications
# =========================================================

AUTH_SERVER_PUBLIC_URL=http://localhost:3000
AUTH_SERVER_INTERNAL_URL=http://localhost:3000
AUTH_SERVER_REQUEST_TIMEOUT_MS=5000

APP_A_COOKIE_NAME=labpro_app_a
APP_A_SESSION_TTL_SECONDS=3600
APP_A_OAUTH_TRANSACTION_TTL_SECONDS=600
APP_A_INTERNAL_LOGOUT_SECRET=replace-with-strong-random-secret

APP_B_COOKIE_NAME=labpro_app_b
APP_B_SESSION_TTL_SECONDS=3600
APP_B_OAUTH_TRANSACTION_TTL_SECONDS=600
APP_B_INTERNAL_LOGOUT_SECRET=replace-with-strong-random-secret

# =========================================================
# Event Processing
# =========================================================

SYNC_EXCHANGE_NAME=labpro.sync
SYNC_MAIN_QUEUE_NAME=labpro.sync.main
SYNC_MAIN_ROUTING_KEY=main

SYNC_DLQ_NAME=labpro.sync.dlq
SYNC_DLQ_ROUTING_KEY=dlq

SYNC_RETRY_DELAYS_MS=5000,15000,30000

EVENT_PUBLISHER_POLL_INTERVAL_MS=1000
EVENT_PUBLISHER_BATCH_SIZE=50

SYNC_WORKER_PREFETCH=8
SYNC_WORKER_REQUEST_TIMEOUT_MS=5000

SHUTDOWN_TIMEOUT_MS=10000