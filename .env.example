# =========================================================
# Runtime
# =========================================================

NODE_ENV=development

# =========================================================
# Service Ports
# =========================================================

AUTH_SERVER_PORT=3000
CONTROL_PANEL_PORT=3001

APP_A_PORT=4000
APP_B_PORT=4001

SYNC_WORKER_PORT=5000
EVENT_PUBLISHER_PORT=5001

# =========================================================
# Primary Database
# =========================================================

PRIMARY_DB_USER=labpro
PRIMARY_DB_PASSWORD=change-me
PRIMARY_DB_NAME=auth_provider
PRIMARY_DB_PORT=5432

# Used when service is run directly from host machine
PRIMARY_DATABASE_URL=postgresql://labpro:change-me@localhost:5432/auth_provider

# =========================================================
# App A Database
# =========================================================

APP_A_DB_USER=labpro
APP_A_DB_PASSWORD=change-me
APP_A_DB_NAME=app_a
APP_A_DB_PORT=5433

# Used when service is run directly from host machine
APP_A_DATABASE_URL=postgresql://labpro:change-me@localhost:5433/app_a

# =========================================================
# App B Database
# =========================================================

APP_B_DB_USER=labpro
APP_B_DB_PASSWORD=change-me
APP_B_DB_NAME=app_b
APP_B_DB_PORT=5434

# Used when service is run directly from host machine
APP_B_DATABASE_URL=postgresql://labpro:change-me@localhost:5434/app_b

# =========================================================
# RabbitMQ
# =========================================================

RABBITMQ_USER=labpro
RABBITMQ_PASSWORD=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Used when service is run directly from host machine
RABBITMQ_URL=amqp://labpro:change-me@localhost:5672

# =========================================================
# Auth Provider
# =========================================================

CONTROL_PANEL_ORIGIN=http://localhost:3001

SSO_COOKIE_NAME=labpro_sso
SSO_SESSION_TTL_SECONDS=28800

AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=3600

APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=change-me-app-a-secret
APP_A_REDIRECT_URI=http://localhost:4000/callback
APP_A_LAUNCH_URL=http://localhost:4000
APP_A_LOGOUT_NOTIFICATION_URL=http://app-a:4000/internal/logout

APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=change-me-app-b-secret
APP_B_REDIRECT_URI=http://localhost:4001/callback
APP_B_LAUNCH_URL=http://localhost:4001
APP_B_LOGOUT_NOTIFICATION_URL=http://app-b:4001/internal/logout

SEED_USER_PASSWORD=change-me-user-password

# =========================================================
# Control Panel
# =========================================================

VITE_AUTH_SERVER_URL=http://localhost:3000