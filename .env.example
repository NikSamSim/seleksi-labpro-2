# =========================================================
# Runtime
# =========================================================

NODE_ENV=development

# =========================================================
# Service Ports
# =========================================================

AUTH_SERVER_PORT=3000
CONTROL_PANEL_PORT=3001

APP_A_PORT=4000
APP_B_PORT=4001

SYNC_WORKER_PORT=5000
EVENT_PUBLISHER_PORT=5001

# =========================================================
# Primary Database
# =========================================================

PRIMARY_DB_USER=labpro
PRIMARY_DB_PASSWORD=change-me
PRIMARY_DB_NAME=auth_provider
PRIMARY_DB_PORT=5432

# Used when service is run directly from host machine
PRIMARY_DATABASE_URL=postgresql://labpro:change-me@localhost:5432/auth_provider

# =========================================================
# App A Database
# =========================================================

APP_A_DB_USER=labpro
APP_A_DB_PASSWORD=change-me
APP_A_DB_NAME=app_a
APP_A_DB_PORT=5433

# Used when service is run directly from host machine
APP_A_DATABASE_URL=postgresql://labpro:change-me@localhost:5433/app_a

# =========================================================
# App B Database
# =========================================================

APP_B_DB_USER=labpro
APP_B_DB_PASSWORD=change-me
APP_B_DB_NAME=app_b
APP_B_DB_PORT=5434

# Used when service is run directly from host machine
APP_B_DATABASE_URL=postgresql://labpro:change-me@localhost:5434/app_b

# =========================================================
# RabbitMQ
# =========================================================

RABBITMQ_USER=labpro
RABBITMQ_PASSWORD=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Used when service is run directly from host machine
RABBITMQ_URL=amqp://labpro:change-me@localhost:5672